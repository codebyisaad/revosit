# Build context should carry source only — everything below is rebuilt,
# irrelevant to the image, or must never be baked into a layer.
node_modules
.next
.git
.gitignore

# Secrets. .env.example is harmless but there is no reason to ship it.
.env
.env.*

npm-debug.log*
*.tsbuildinfo
next-env.d.ts
.DS_Store

# Preview-only routes. A runtime NODE_ENV guard is not enough on its own:
# Next prerenders the route anyway and still answers 200 with the content in
# the RSC payload. Keeping them out of the build context is what guarantees
# they cannot reach production.
src/app/dev

README.md
AGENTS.md
CLAUDE.md
Dockerfile
.dockerignore
docker-compose.yml
