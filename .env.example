# Copy to .env on the server and fill in. Nothing here is read at build time
# except NEXT_PUBLIC_SITE_URL, which is baked in and needs a rebuild to change.

# Canonical origin — drives canonical URLs, sitemap.xml, robots.txt and OG tags.
NEXT_PUBLIC_SITE_URL=https://revosit.com

# ---------------------------------------------------------------------------
# Contact form mailbox — Zoho SMTP
#
# SMTP_PASS is an APP PASSWORD, not the account's login password. With 2FA on,
# Zoho rejects the login password outright.
#   Zoho Mail -> My Account -> Security -> App Passwords -> Generate New Password
#
# SMTP_HOST is region-specific. Pick the datacentre your Zoho account lives in:
#   smtp.zoho.com     US   (default)
#   smtp.zoho.eu      EU
#   smtp.zoho.in      India
#   smtp.zoho.com.au  Australia
# The wrong region fails as an authentication error, which is misleading.
#
# Port 465 is implicit TLS. Use 587 only if you specifically need STARTTLS.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465

# The full mailbox address, e.g. support@revosit.com
SMTP_USER=
SMTP_PASS=

# Envelope sender. Zoho requires this to be the authenticated address or one of
# its verified aliases. Defaults to "Revosit <SMTP_USER>" when left blank.
CONTACT_FROM=

# Where enquiries land. Replying goes to the person who filled the form.
CONTACT_TO=support@revosit.com
